# Local development only. Replace with a random URL-safe password before starting.
FLOWDOC_DB_PASSWORD=replace-with-random-url-safe-value
# Export results are temporary by default; recreate api after configuration changes.
EXPORT_RETAIN_FILES=false
EXPORT_FILE_TTL_HOURS=24
EXPORT_TEMP_FILE_TTL_HOURS=24
FLOWDOC_API_PORT=3000
